<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles every csharp block of README.md and docs/*.md so the documentation cannot drift from the API.
    Each block becomes the body of one async method; leading using directives move to the top of the file.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <SnippetDirectory>$(MSBuildProjectDirectory)/obj/snippets/$(TargetFramework)</SnippetDirectory>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\src\Koldera.Sdk\Koldera.Sdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <DocumentWithSnippets Include="..\..\README.md;..\..\docs\*.md" />
  </ItemGroup>

  <UsingTask TaskName="ExtractSnippets" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputDirectory ParameterType="System.String" Required="true" />
      <Generated ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="System.Collections.Generic" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Directory.CreateDirectory(OutputDirectory);
        foreach (var old in Directory.GetFiles(OutputDirectory, "*.cs")) File.Delete(old);
        var block = new Regex(@"^```csharp[ \t]*\r?\n(.*?)^```[ \t]*\r?$", RegexOptions.Singleline | RegexOptions.Multiline);
        var directive = new Regex(@"^using\s+(static\s+)?[A-Za-z_][\w.]*(\s*=\s*[\w.<>,\s]+)?;\s*$");
        var files = new List<ITaskItem>();
        var count = 0;
        foreach (var source in Sources)
        {
            var text = File.ReadAllText(source.ItemSpec);
            foreach (Match m in block.Matches(text))
            {
                count++;
                var usings = new List<string>();
                var body = new StringBuilder();
                var leading = true;
                foreach (var line in m.Groups[1].Value.Replace("\r", "").Split('\n'))
                {
                    if (leading && (line.Trim().Length == 0 || directive.IsMatch(line.Trim()) && !line.TrimStart().StartsWith("using var ")))
                    {
                        if (line.Trim().Length > 0) usings.Add(line.Trim());
                        continue;
                    }
                    leading = false;
                    body.AppendLine(line);
                }
                var name = "Snippet" + count.ToString("000");
                var code = new StringBuilder();
                code.AppendLine("// <auto-generated from " + Path.GetFileName(source.ItemSpec) + "/>");
                code.AppendLine("#nullable enable");
                code.AppendLine("#pragma warning disable CS1998, CS8321");
                foreach (var u in usings) code.AppendLine(u);
                code.AppendLine("namespace Koldera.Docs;");
                // A block that uses `client` without declaring it continues from an earlier example: it receives one.
                var text2 = body.ToString();
                var needsClient = Regex.IsMatch(text2, @"\bclient\.") && !Regex.IsMatch(text2, @"\bclient\s*=|KolderaClient client");
                code.AppendLine("internal static class " + name + " { internal static async System.Threading.Tasks.Task Run(string[] args" + (needsClient ? ", Koldera.IKolderaClient client" : "") + ") {");
                code.Append(body);
                code.AppendLine("} }");
                var path = Path.Combine(OutputDirectory, name + ".cs");
                File.WriteAllText(path, code.ToString());
                files.Add(new Microsoft.Build.Utilities.TaskItem(path));
            }
        }
        if (count == 0) Log.LogError("No csharp blocks were found in the documentation.");
        Generated = files.ToArray();
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateSnippets" BeforeTargets="CoreCompile">
    <ExtractSnippets Sources="@(DocumentWithSnippets)" OutputDirectory="$(SnippetDirectory)">
      <Output TaskParameter="Generated" ItemName="GeneratedSnippet" />
    </ExtractSnippets>
    <ItemGroup>
      <Compile Include="@(GeneratedSnippet)" />
    </ItemGroup>
  </Target>
</Project>
